GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Export access stays disabled until a unique secret of at least 32 characters is set.
DRIVE_EXPORT_KEY=
# Azure bootstrap: supply a unique administrator ID and strong password.
# The local launcher generates its own random password in LOCAL_DATA_DIR/settings.json.
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_REVISION=
ADMIN_SESSION_SECRET=
API_KEY_ENCRYPTION_SECRET=
# Local execution always uses SQLite and local files, even if Azure variables exist.
LOCAL_DATA_DIR=.local-data
# Azure App Service only: set these in Azure application settings.
DATABASE_URL=
DATABASE_POOL_SIZE=5
SITE_URL=http://localhost:3000
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=knowledge-files
# Local fallback only. In Azure, prefer the App Service managed identity above.
AZURE_STORAGE_CONNECTION_STRING=
# Optional self-hosted Docling service. Without these values, PDF.js remains active.
DOCLING_SERVICE_URL=
DOCLING_SHARED_SECRET=
DOCLING_TIMEOUT_MS=180000

# Daily retention maintenance uses a separate random secret of at least 32 characters.
RETENTION_MAINTENANCE_KEY=
# AI request timeout, clamped to 1000..180000 milliseconds.
AI_REQUEST_TIMEOUT_MS=60000
