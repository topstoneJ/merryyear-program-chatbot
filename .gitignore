# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/build/
gitleaks-*.json
/.wrangler/
/outputs/
/work/
.recovery/

# local deployment packages and staging directories
/azure-stage*/
/azure-deploy*.zip
/site*.tar

# local databases and data exports
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
